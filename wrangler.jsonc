{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jarvis-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
